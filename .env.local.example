# --- Sanity (blog CMS) ---
# From manage.sanity.io after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Shared secret for the Sanity → /api/revalidate webhook (any random string;
# set the same value in the Sanity webhook config).
SANITY_REVALIDATE_SECRET=

# NOTE: the Viktor bot's write token is configured on Viktor's side, NOT here.
# It must never be exposed to the browser. See docs/VIKTOR_BLOG_API.md.
